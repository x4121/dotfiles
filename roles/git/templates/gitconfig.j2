# gitconfig
[user]
    name = {{ full_name }}
    email = {{ email }}
[github]
    user = {{ github_handle }}
[core]
    excludesfile = {{ ansible_user_dir }}.gitignore_global
[push]
    default = simple
[pull]
    ff = only
[fetch]
    prune = true
[status]
    branch = true
    short = true
[diff]
    wsErrorHighlight = all
    tool = vimdiff
[difftool]
    prompt = false
    trustExitCode = true
[difftool "vimdiff"]
    cmd = vimdiff \"$LOCAL\" \"$REMOTE\"
[merge]
    tool = vimdiff
[mergetool]
    prompt = false
    conflictstyle = diff3
[commit]
    gpgSign = true
[alias]
    lol = log --graph --decorate --oneline
    lola = log --graph --decorate --oneline --all
    save = !sh -c 'export PREV=$(git symbolic-ref HEAD|cut -d/ -f3-) && git checkout -b "$1" && git commit -am "$1" && git checkout "$PREV"' -
[init]
	  defaultBranch = main
[filter "lfs"]
	  required = true
	  clean = git-lfs clean -- %f
	  smudge = git-lfs smudge -- %f
	  process = git-lfs process -- %f
